// Synthetic data generated by scripts/generate_reference.py; not production code.

///|
test "pymcdm 1.3.1 synthetic differential case 00" {
  let m = decision_matrix(
    ["a0", "a1", "a2", "a3", "a4"],
    ["x", "y", "z"],
    [Benefit, Cost, Benefit],
    [
      [20.0, 35.125, 9.25],
      [51.0, 79.125, 52.25],
      [53.0, 72.125, 79.25],
      [59.0, 24.125, 74.25],
      [42.0, 32.125, 24.25],
    ],
  )
  let w = [0.375, 0.0625, 0.5625]
  close_arrays(topsis(m, w).ranking.scores, [
    0.06885568844700218, 0.6567256987429789, 0.8905299952865428, 0.9414482025677346,
    0.34591859826215926,
  ])
  close_arrays(vikor(m, w).ranking.scores, [
    1.0, 0.3430059636144033, 0.056366018923579134, 0.0, 0.7002477404832654,
  ])
  close_arrays(promethee(m, w, [Usual, Usual, Usual]).ranking.scores, [
    -0.9375, -0.0625, 0.71875, 0.71875, -0.4375,
  ])
  close_arrays(weighted_product(m, w).ranking.scores, [
    -1.6373968908522964, -0.36319742484624273, -0.10866407873280004, -0.03665791972945204,
    -0.8114568755055954,
  ])
}

